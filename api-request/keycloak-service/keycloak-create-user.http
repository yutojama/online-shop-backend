### Get access token with confidential client
POST http://localhost:8081/realms/portshop-realm/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials
    &client_id=portshop-api
    &client_secret=fMBKIo1lQVsIgVW0Ln8evxFgU7fGZhbEjTsuUzjDdTegbtrS1ze2U269BCA0W50D7WtXGTteID0BuokhlWFZ12

> {%
    client.global.set("client_access_token", response.body.access_token);
    console.log("Client access token saved: ", client.global.get("client_access_token"))
%}

### Create user account
POST http://localhost:8081/admin/realms/portshop-realm/users
Authorization: Bearer {{client_access_token}}
Content-Type: application/json

{
  "username": "john",
  "email": "john@gmail.com",
  "firstName": "John",
  "lastName": "Doe",
  "enabled": true,
  "emailVerified": false
}

### Get a user
GET http://localhost:8081/admin/realms/portshop-realm/users/dc409009-c67f-4980-9bb7-6946e0f532d1
Authorization: Bearer {{client_access_token}}

### Delete a user
DELETE http://localhost:8081/admin/realms/portshop-realm/users/dc409009-c67f-4980-9bb7-6946e0f532d1
Authorization: Bearer {{client_access_token}}

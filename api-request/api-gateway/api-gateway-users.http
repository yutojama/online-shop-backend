### Login admin
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password"
}

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
    console.log("access token saved: ", client.global.get("access_token"))
    console.log("refresh token saved: ", client.global.get("refresh_token"))
%}

### Login user
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "username": "jamielynn",
  "password": "password"
}

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
    console.log("access token saved: ", client.global.get("access_token"));
    console.log("refresh token saved: ", client.global.get("refresh_token"));
%}

### Logout user
POST http://localhost:4000/api/users/logout
Content-Type: application/json

{
  "refreshToken": "{{refresh_token}}"
}

> {%
    client.global.set("access_token", "");
    console.log("access token deleted");
%}

### Register/add user
POST http://localhost:4000/api/users/register
Content-Type: application/json

{
  "email": "jamielynn@yahoo.com",
  "password": "password",
  "firstName": "Jamie",
  "lastName": "Lynn",
  "phone": "0157595248586"
}



### GET keycloak token
POST http://localhost:8081/realms/portshop-realm/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id=portshop-api
    &client_secret=fMBKIo1lQVsIgVW0Ln8evxFgU7fGZhbEjTsuUzjDdTegbtrS1ze2U269BCA0W50D7WtXGTteID0BuokhlWFZ12
    &username=admin_user&password=password&grant_type=password

> {%
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);

    console.log("Access token saved: ", client.global.get("access_token"))
    console.log("Refresh token saved: ", client.global.get("refresh_token"))
%}
###

### Refresh Keycloak access token
POST http://localhost:8081/realms/portshop-realm/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token
    &client_id=portshop-api
    &client_secret=fMBKIo1lQVsIgVW0Ln8evxFgU7fGZhbEjTsuUzjDdTegbtrS1ze2U269BCA0W50D7WtXGTteID0BuokhlWFZ12
    &refresh_token={{refresh_token}}

> {%
    console.log("Access token deprecated: ", client.global.get("access_token"));
    client.global.set("access_token", response.body.access_token);
    console.log("Access token deprecated: ", client.global.get("access_token"));
 %}
###

### Test GET request with/without access token
GET http://localhost:4000/api/products/4c1c0756-898d-4104-a57d-352dcdd4c47e
Authorization: Bearer {{access_token}}

###